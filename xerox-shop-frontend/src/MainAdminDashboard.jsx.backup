
import { useEffect, useState } from 'react'

const API_URL = import.meta.env.VITE_API_URL || 'http://localhost:8080'

export default function MainAdminDashboard({ onBack }) {
  const [data, setData] = useState(null)
  const [error, setError] = useState('')
  const [loading, setLoading] = useState(true)

  useEffect(() => {
    let cancelled = false

    async function loadDashboard() {
      try {
        const auth = sessionStorage.getItem('xeroxwalaAdminAuth')

        if (!auth) {
          throw new Error('Admin session not found. Please sign in again.')
        }

        const response = await fetch(`${API_URL}/api/admin/dashboard`, {
          headers: {
            Authorization: `Basic ${auth}`,
            Accept: 'application/json',
          },
        })

        if (!response.ok) {
          throw new Error(
            response.status === 401 || response.status === 403
              ? 'Admin authentication failed. Please sign in again.'
              : `Could not load dashboard (HTTP ${response.status}).`
          )
        }

        const result = await response.json()
        if (!cancelled) setData(result)
      } catch (err) {
        if (!cancelled) setError(err.message || 'Unable to load dashboard.')
      } finally {
        if (!cancelled) setLoading(false)
      }
    }

    loadDashboard()
    return () => { cancelled = true }
  }, [])

  if (loading) return <main className="admin-page"><p>Loading admin dashboard...</p></main>

  if (error) {
    return (
      <main className="admin-page">
        <h1>Main Admin Dashboard</h1>
        <p role="alert">{error}</p>
        <button onClick={onBack}>Back to website</button>
      </main>
    )
  }

  const customers = data?.customers || []
  const owners = data?.shopOwners || []
  const orders = data?.orders || []

  return (
    <main className="admin-page">
      <header className="admin-header">
        <div>
          <p className="admin-eyebrow">XERoxWALA MANAGEMENT</p>
          <h1>Main Admin Dashboard</h1>
          <p>Manage customers, shop owners and print orders.</p>
        </div>
        <button
          onClick={() => {
            sessionStorage.removeItem('xeroxwalaAdminAuth')
            sessionStorage.removeItem('xeroxwalaAdminDashboard')
            onBack()
          }}
        >
          Sign out
        </button>
      </header>

      <section className="admin-stats">
        <article><span>Total customers</span><strong>{customers.length}</strong></article>
        <article><span>Shop owners</span><strong>{owners.length}</strong></article>
        <article><span>Total orders</span><strong>{orders.length}</strong></article>
      </section>

      <section className="admin-panel">
        <h2>Customers</h2>
        {customers.length === 0 ? <p>No customers registered yet.</p> : (
          <div className="admin-table-wrap">
            <table className="admin-table">
              <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Joined</th></tr></thead>
              <tbody>
                {customers.map(c => (
                  <tr key={c.customerId}>
                    <td>{c.customerId}</td><td>{c.fullName}</td>
                    <td>{c.email || '—'}</td><td>{c.phone || '—'}</td>
                    <td>{c.createdAt ? new Date(c.createdAt).toLocaleDateString() : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <section className="admin-panel">
        <h2>Shop owners</h2>
        {owners.length === 0 ? <p>No shop owners registered yet.</p> : (
          <div className="admin-table-wrap">
            <table className="admin-table">
              <thead><tr><th>Name</th><th>Username</th><th>Shop</th><th>Phone</th><th>Account</th></tr></thead>
              <tbody>
                {owners.map(o => (
                  <tr key={o.ownerId}>
                    <td>{o.ownerName}</td><td>{o.username}</td>
                    <td>{o.shopName || 'No shop linked'}</td>
                    <td>{o.phone || '—'}</td>
                    <td><span className={o.enabled ? 'admin-status active' : 'admin-status pending'}>{o.enabled ? 'Enabled' : 'Pending'}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <section className="admin-panel">
        <h2>Print orders</h2>
        {orders.length === 0 ? <p>No print orders yet.</p> : (
          <div className="admin-table-wrap">
            <table className="admin-table">
              <thead><tr><th>Order</th><th>Customer</th><th>Phone</th><th>Shop</th><th>Amount</th><th>Order status</th><th>Payment</th></tr></thead>
              <tbody>
                {orders.map(o => (
                  <tr key={o.orderId}>
                    <td>{o.orderNumber || o.orderId}</td>
                    <td>{o.customerName || 'Unknown'}</td>
                    <td>{o.customerPhone || '—'}</td>
                    <td>{o.shopName || '—'}</td>
                    <td>₹{Number(o.totalAmount || 0).toFixed(2)}</td>
                    <td>{o.orderStatus || '—'}</td>
                    <td>{o.paymentStatus || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </main>
  )
}
